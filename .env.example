# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Phase 1: Supabase (supabase.com — free tier) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 3: Groq (console.groq.com — free tier) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Phase 4: Make.com webhook shared secret (you set this in Make.com's HTTP header) ---
MAKE_WEBHOOK_SECRET=

# --- Phase 4: Make.com Custom Webhook URL (this app calls out to it on application events) ---
MAKE_APPLICATION_WEBHOOK_URL=

# --- Phase 5: Google Calendar / Gmail (configured inside Make.com, not here) ---

# --- Phase 6: DocuSign / Dropbox Sign (configured inside Make.com, not here) ---

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
